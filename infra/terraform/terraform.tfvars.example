# ──────────────────────────────────────────────────────────────────────────────
# terraform.tfvars.example — Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars — it is blocked by .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# AWS Key Pair name (must exist in AWS Console → EC2 → Key Pairs)
key_pair_name = "modula-prod-key"

# Your public IP for SSH access. Find it: curl -s ifconfig.me
# Use /32 for a single IP. Leave empty [] to disable SSH (use SSM instead).
ssh_allowed_cidrs = ["YOUR_IP/32"]

# Git repository URL (cloned on instance boot via user-data.sh)
app_repo_url = "https://github.com/YOUR_USER/Hackaton-kiro_modulapp.git"
app_branch   = "main"

# Cloudflare Tunnel token (from Cloudflare dashboard → Networks → Tunnels)
# Leave empty "" to skip tunnel setup.
cloudflare_tunnel_token = ""

# Instance sizing (t3.small minimum recommended for 4 containers + build)
instance_type    = "t3.small"
root_volume_size = 30
