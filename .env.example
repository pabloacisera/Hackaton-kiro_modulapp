# Copy this file to .env and fill in your values.
# See .kiro/steerings/09-environment-variables.md for full documentation.
# NEVER commit .env — it is blocked by .gitignore.

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────

# ─── Public URL (used in emails for customer-facing links) ───────────────────
# In production: APP_PUBLIC_URL=https://modula.artisandevs.site
APP_PUBLIC_URL=http://localhost:3000

# ─── Database (AWS RDS — api-core via Prisma) ────────────────────────────────
# IAM auth: set DB_* vars; the app generates tokens at runtime.
# Static password: set DATABASE_URL directly (local dev only).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_REGION=us-east-2
DATABASE_URL=

# ─── Database (AWS RDS — payment-service via Spring Boot) ────────────────────
PAYMENT_DB_HOST=
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=postgres
PAYMENT_DB_USER=postgres
PAYMENT_DB_REGION=us-east-2
# Format: postgresql://user:password@host:port/db  (the "jdbc:" prefix is added by the app)
PAYMENT_DATABASE_URL=

# ─── Redis (Upstash REST — cache & rate limiting) ────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Redis (BullMQ queues — requires local Redis with persistent TCP) ────────
# Local dev: docker run -d --name redis-local -p 6379:6379 redis:7-alpine
# Docker Compose: set REDIS_HOST=modulapp-redis
# Optional explicit URL (overrides REDIS_HOST): BULL_REDIS_URL=redis://localhost:6379
BULL_REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QUOTE_ACTION_TOKEN_SECRET=

# ─── Bootstrap admin (dev only — seeded when NODE_ENV != production) ─────────
# Defaults: admin@modulapp.com / Password123456
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ─── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=

# ─── Internal Webhooks (api-core ↔ payment-service) ──────────────────────────
WEBHOOK_SHARED_SECRET=
PAYMENT_SERVICE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# ─── Admin Dashboard URL (used in registration emails) ───────────────────────
ADMIN_DASHBOARD_URL=http://localhost:3001

# ─── Mailjet (transactional email) ───────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GitHub (MCP server — .kiro/mcp/mcp.json) ────────────────────────────────
GITHUB_TOKEN=

# ─── Google Drive (scripts/package-flows.sh) ─────────────────────────────────
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
