# Copy this file to .env and fill in your values.
# See .kiro/steerings/09-environment-variables.md for full documentation.
# NEVER commit .env — it is blocked by .gitignore.

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=/api

# ─── Public URL (used by PayPal return URLs and email links) ─────────────────
# Production: APP_PUBLIC_URL=https://modula.artisandevs.site
APP_PUBLIC_URL=http://localhost

# ─── Database (AWS RDS — api-core via Prisma) ────────────────────────────────
DATABASE_URL=

# ─── Database (AWS RDS — payment-service via Spring Boot) ────────────────────
# Format: postgresql://user:password@host:port/db
PAYMENT_DATABASE_URL=
PAYMENT_DB_REGION=us-east-2

# ─── Redis (Upstash REST — cache & rate limiting) ────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Redis (BullMQ queues — requires persistent TCP connection) ───────────────
# Docker Compose dev: REDIS_HOST=redis
# Docker Compose prod: REDIS_HOST=redis
# Local without Docker: REDIS_HOST=localhost
REDIS_HOST=redis

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QUOTE_ACTION_TOKEN_SECRET=

# ─── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_WEBHOOK_URL=

# ─── Mailjet (transactional email) ───────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# ─── Internal Webhooks (api-core ↔ payment-service) ──────────────────────────
WEBHOOK_SHARED_SECRET=
PAYMENT_SERVICE_URL=http://payment-service:8081
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost

# ─── Admin Dashboard URL (used in registration emails) ───────────────────────
ADMIN_DASHBOARD_URL=http://localhost:3001/admin

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GitHub (MCP server — .kiro/mcp/mcp.json) ────────────────────────────────
GITHUB_TOKEN=

# ─── Google Drive (scripts/package-flows.sh) ─────────────────────────────────
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
GOOGLE_TOKEN_INPUT=https://oauth2.googleapis.com/token
GOOGLE_AUTORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_DRIVE_API=https://www.googleapis.com/auth/drive
GOOGLE_AUTORIZATION_CODE=
