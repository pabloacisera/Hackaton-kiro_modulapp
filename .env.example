# Copy this file to .env and fill in your values.
# See .kiro/steerings/09-environment-variables.md for full documentation.
# NEVER commit .env — it is blocked by .gitignore.

# ─── Database (AWS RDS — api-core via Prisma) ────────────────────────────────
# IAM auth: set DB_* vars; the app generates tokens at runtime.
# Static password: set DATABASE_URL directly (local dev only).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_REGION=us-east-2
DATABASE_URL=

# ─── Database (AWS RDS — payment-service via Spring Boot) ────────────────────
PAYMENT_DB_HOST=
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=postgres
PAYMENT_DB_USER=postgres
PAYMENT_DB_REGION=us-east-2
PAYMENT_DATABASE_URL=

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_URL=

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
QUOTE_ACTION_TOKEN_SECRET=

# ─── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# ─── Internal Webhooks (api-core ↔ payment-service) ──────────────────────────
WEBHOOK_SHARED_SECRET=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Mailjet (transactional email) ───────────────────────────────────────────
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=

# ─── Supabase Storage ────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GitHub (MCP server — .kiro/mcp/mcp.json) ────────────────────────────────
GITHUB_TOKEN=

# ─── Google Drive (scripts/package-flows.sh) ─────────────────────────────────
GOOGLE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
