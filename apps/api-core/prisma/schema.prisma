// Prisma schema — datasource + generator
// Tables are added per feature spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Admin Auth ────────────────────────────────────────────────────────────────

model AdminUser {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  lastLoginAt   DateTime?      @map("last_login_at")
  refreshTokens RefreshToken[]

  @@map("admin_users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@map("refresh_tokens")
}

// ── Catalog ───────────────────────────────────────────────────────────────────

enum PrototypeCategory {
  modular_furniture
  arches
}

model Prototype {
  id                    String            @id @default(uuid())
  name                  String
  description           String
  category              PrototypeCategory
  priceUsd              Decimal           @map("price_usd") @db.Decimal(10, 2)
  active                Boolean           @default(true)
  stockQty              Int               @default(0) @map("stock_qty")
  buildOnDemand         Boolean           @default(false) @map("build_on_demand")
  estimatedDeliveryDays Int?              @map("estimated_delivery_days")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  images                ProtoImage[]

  @@map("prototypes")
}

model ProtoImage {
  id          String    @id @default(uuid())
  prototypeId String    @map("prototype_id")
  url         String
  order       Int       @default(0)
  prototype   Prototype @relation(fields: [prototypeId], references: [id], onDelete: Cascade)

  @@map("proto_images")
}

// ── Orders (Flow A — Direct Purchase) ────────────────────────────────────────

enum OrderStatus {
  created
  payment_initiated
  paid_pending_acceptance
  accepted
  rejected
  payment_failed
}

model Order {
  id                    String      @id @default(uuid())
  prototypeId           String      @map("prototype_id")
  priceUsdSnapshot      Decimal     @map("price_usd_snapshot") @db.Decimal(10, 2)
  customerEmail         String      @map("customer_email")
  customerName          String?     @map("customer_name")
  status                OrderStatus @default(created)
  rejectionReason       String?     @map("rejection_reason")
  estimatedDeliveryDate DateTime?   @map("estimated_delivery_date")
  paymentServiceRef     String?     @map("payment_service_ref")
  idempotencyKey        String      @unique @map("idempotency_key")
  locale                String      @default("es") @db.VarChar(5)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  @@map("orders")
}

// ── Quotes (Flow B — Custom Quote) ────────────────────────────────────────────

enum QuoteStatus {
  discarded_incomplete_data
  pending
  quoted
  accepted
  rejected
  expired
  payment_initiated
  paid
  payment_expired
  archived
}

model Quote {
  id                    String      @id @default(uuid())
  customerName          String      @map("customer_name")
  customerEmail         String      @map("customer_email")
  customerPhone         String      @map("customer_phone")
  description           String
  neededByDate          DateTime    @map("needed_by_date") @db.Date
  status                QuoteStatus @default(pending)
  quotedPriceUsd        Decimal?    @map("quoted_price_usd") @db.Decimal(10, 2)
  quotedLeadTimeDays    Int?        @map("quoted_lead_time_days")
  estimatedDeliveryDate DateTime?   @map("estimated_delivery_date") @db.Date
  quoteSentAt           DateTime?   @map("quote_sent_at")
  quoteResponseDeadline DateTime?   @map("quote_response_deadline")
  paymentDeadline       DateTime?   @map("payment_deadline")
  acceptedAt            DateTime?   @map("accepted_at")
  rejectedAt            DateTime?   @map("rejected_at")
  paidAt                DateTime?   @map("paid_at")
  rejectionReason       String?     @map("rejection_reason")
  actionTokenHash       String?     @map("action_token_hash")
  actionTokenUsed       Boolean     @default(false) @map("action_token_used")
  paymentServiceRef     String?     @map("payment_service_ref")
  quotePdfUrl           String?     @map("quote_pdf_url") @db.VarChar(512)
  locale                String      @default("es") @db.VarChar(5)
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  @@map("quotes")
}

// ── Complaints & Refunds ──────────────────────────────────────────────────────

enum ComplaintReferenceType {
  order
  quote
  unknown
}

enum ComplaintStatus {
  received
  under_review
  refund_approved
  resolved_other_way
  rejected
}

model Complaint {
  id              String                 @id @default(uuid())
  referenceType   ComplaintReferenceType @map("reference_type")
  referenceId     String?                @map("reference_id")
  customerName    String                 @map("customer_name")
  customerEmail   String                 @map("customer_email")
  customerPhone   String?                @map("customer_phone")
  reason          String
  status          ComplaintStatus        @default(received)
  resolutionNotes String?                @map("resolution_notes")
  refundRequestId String?                @map("refund_request_id")
  locale          String                 @default("es") @db.VarChar(5)
  createdAt       DateTime               @default(now()) @map("created_at")
  resolvedAt      DateTime?              @map("resolved_at")

  @@map("complaints")
}

// ── Supply Stock Management ───────────────────────────────────────────────────

model Supply {
  id          String   @id @default(uuid())
  sku         String   @unique
  name        String
  unit        String   // e.g.: "unit", "m2", "kg"
  currentQty  Decimal  @map("current_qty") @db.Decimal(10, 2)
  minStock    Decimal  @map("min_stock") @db.Decimal(10, 2)
  unitCostUsd Decimal  @map("unit_cost_usd") @db.Decimal(10, 2)
  supplier    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  changeLogs SupplyStockChangeLog[]
  alertState LowStockAlertState?

  @@map("supplies")
}

enum StockChangeSource {
  manual
  excel_import
  order_consumption
}

model SupplyStockChangeLog {
  id          String            @id @default(uuid())
  supplyId    String            @map("supply_id")
  previousQty Decimal           @map("previous_qty") @db.Decimal(10, 2)
  newQty      Decimal           @map("new_qty") @db.Decimal(10, 2)
  source      StockChangeSource
  actor       String
  createdAt   DateTime          @default(now()) @map("created_at")
  supply      Supply            @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@map("supply_stock_change_log")
}

model LowStockAlertState {
  id              String   @id @default(uuid())
  supplyId        String   @unique @map("supply_id")
  lastNotifiedAt  DateTime @map("last_notified_at")
  lastNotifiedQty Decimal  @map("last_notified_qty") @db.Decimal(10, 2)
  supply          Supply   @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@map("low_stock_alert_state")
}

// ── Notifications ─────────────────────────────────────────────────────────────

enum NotificationType {
  new_purchase
  new_quote_request
  quote_response
  new_complaint
  low_stock_minimum
  payment_confirmed
}

model AdminNotification {
  id           String           @id @default(uuid())
  type         NotificationType
  message      String
  referenceUrl String           @map("reference_url")
  read         Boolean          @default(false)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("admin_notifications")
}
